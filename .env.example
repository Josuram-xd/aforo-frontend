# Supabase project (Settings -> API). Only the publishable key goes here — never the service_role key.
# Put the real values in .env.local (gitignored) and, for deploys, in the Amplify console.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Set to "true" to use built-in sample data and a fake session (dev server only).
VITE_USE_MOCK=false
# Role simulated in mock mode: admin | teacher | viewer
VITE_MOCK_ROLE=admin
